# Absolute production URL, used for canonical URLs, sitemap, Open Graph and CMS CSRF.
# Today: the Vercel production URL. Later: https://mikelarnao.com
SITE_URL=http://localhost:3000

# Postgres connection string (local: pnpm db:dev; production: Neon via Vercel)
DATABASE_URI=postgres://postgres:postgres@localhost:5433/portfolio

# Long random string for Payload sessions (generate a new one per environment)
PAYLOAD_SECRET=

# Set automatically by Vercel when Blob storage is connected; leave empty locally
BLOB_READ_WRITE_TOKEN=
